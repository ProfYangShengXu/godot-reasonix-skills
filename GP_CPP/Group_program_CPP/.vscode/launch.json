{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug sport_evaluation_system",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/sport_evaluation_system.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/bin",
            "environment": [
                {
                    "name": "PATH",
                    "value": "D:/Qt/6.6.1/mingw_64/bin;${env:PATH}"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "D:/mingw64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "cmake build"
        }
    ]
}
